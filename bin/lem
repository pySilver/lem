#!/usr/bin/env python3
"""lem: Lem's one command. `lem NAME ARGS...` runs the module of Lem's package that NAME
stands for (`src/lem/names.py`), with ARGS as they came; its stdin, stdout, stderr and
exit status are the module's own.

One command, so that one permission rule (`Bash(lem *)`) holds on every machine and
after every update of the plugin: the folder of a plugin's files changes with each
update, and a rule on a script's path stops holding then. The plugin puts this file on
the Bash tool's PATH (`bin/`).

    lem                  the names, one line each (also `lem help`, `lem --help`)
    lem version          the plugin's version and the commit of its folder, as JSON
    lem NAME ARGS...     the module NAME stands for; `lem NAME --help` is the module's own help

The two other commands of the plugin, `lem-ask` and `lem-jev`, are links to this file in
`bin/`, and it runs the module each name stands for (`ALIASES` of `lem.names`) with
every argument.

The process becomes the package's one entry, `python -B src/lem/__main__.py NAME ARGS`
(exec), which runs the module, so nothing stands between the caller and it. Python runs
with -B, so it writes no bytecode in the plugin's folder.

Before it, `lem NAME` takes a cheap look whether the board server of this machine runs:
it reads the server's pid from `serve.pid` in Lem's home folder, which the server writes
at its start and removes at a clean stop, and asks the kernel whether that process lives
(signal 0), with no import of Lem's modules, no connect and no process started. Only
when the file is not there, or its process is gone, does it start `lem serve --ensure`
as a process of its own, with its output in the server's log, and it goes on without a
wait. `serve` itself, `board` and `doctor`, which look at the server their own way, take
no look, and `LEM_SERVE=off` turns it off, which the test suites set. This file loads
under any python3, and so do the two modules it imports where it needs them
(`lem.names`, the table of names, and `lem.python` only under an old python3): when that
python3 is older than Lem's package needs, it runs the entry under the newer Python that
`lem.python.find()` finds, or says in one line what to install. `lem version` and the
hand-over below import neither, so this file alone in a folder answers them.

In Lem's marketplace clone (`PLUGINS/marketplaces/NAME`, which Claude Code pulls from
the head of `main`), this file runs no script of its own: it becomes the `bin/lem` of
the newest release of `lem@NAME` that Claude Code's `PLUGINS/installed_plugins.json`
lists, with the same arguments (`release()`). A line outside Claude Code names the
clone's path, which outlives every update (the doctor's keymap line of the task picker,
and its start of the board server), and runs a release through it, never the head of
`main`. With no such release listed, it exits 1 and names the install. It runs that
file as a program and imports nothing from it: the release may be older than this file
or newer, with its own layout of Lem's Python.
"""  # noqa: E501 - the usage table of the command keeps its columns

import json
import os
import subprocess
import sys
import types

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
# the package's one entry, which runs the module a name stands for
MAIN = os.path.join(ROOT, "src", "lem", "__main__.py")
# The names of the two links to this file in bin/, as `ALIASES` of `lem.names` has them:
# the hand-over in a marketplace clone reads them before anything is imported.
LINKS = ("lem-ask", "lem-jev")


def package() -> None:
    """Put the folder of this plugin's package first on sys.path, for an import from
    it. This file runs under a python3 with no -B, so it turns bytecode off first."""
    sys.dont_write_bytecode = True
    folder = os.path.join(ROOT, "src")
    if folder not in sys.path:
        sys.path.insert(0, folder)


def table() -> types.ModuleType:
    """`lem.names`, the table of the names, from this plugin's package."""
    package()
    from lem import names

    return names


# The commands that take no look at the board server: the server's own, and the two that
# look at it their own way (`board` starts it and waits for it, and `doctor` only
# reports it).
NO_LOOK = ("serve", "board", "doctor")
# The server's pid file and its log in Lem's home folder (lem.state.SERVE_PID and
# SERVE_LOG), by name: the look imports none of Lem's modules (`lem.names`, which this
# file reads first, is a table that imports nothing), since that import was most of its
# cost (8 to 11 ms a call, medians of the builder of 2026-11-21).
PID_FILE = "serve.pid"
SERVE_LOG = "serve.log"


def home() -> "str | None":
    """Lem's home folder as lem.state.config() names it, or None where it refuses (a
    relative XDG_CONFIG_HOME)."""
    named = os.environ.get("XDG_CONFIG_HOME", "")
    if named and not os.path.isabs(named):
        return None
    return os.path.join(
        named or os.path.join(os.path.expanduser("~"), ".config"), "lem"
    )


def server_lives(folder: str) -> bool:
    """Whether the pid in the server's pid file is a process that lives. A file that
    does not read is no server."""
    try:
        with open(os.path.join(folder, PID_FILE), encoding="utf-8") as file:
            pid = int(file.read().split()[0])
    except (OSError, ValueError, IndexError):
        return False
    if pid <= 0:
        # 0 and a negative pid name a process group, never one server
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        # a process of another user holds the pid: it lives, and it is no server to
        # start here
        return True
    return True


def look_for_server(python: str) -> None:
    """Start the board server detached under PYTHON, the one `run` found, when its pid
    file names no process that lives. The look itself needs only `os` and `subprocess`,
    so it runs under any python3. Every failure is silent: the look serves the board,
    and no command of Lem's waits for it or fails by it."""
    if os.environ.get("LEM_SERVE") == "off":
        return
    folder = home()
    if folder is None or server_lives(folder):
        return
    try:
        os.makedirs(folder, exist_ok=True)
        with open(os.path.join(folder, SERVE_LOG), "ab") as log:
            subprocess.Popen(
                [python, "-B", MAIN, "serve", "--ensure"],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=log,
                start_new_session=True,
                close_fds=True,
                cwd=folder,
            )
    except Exception:  # noqa: BLE001 - the command goes on without the board
        return


def names() -> str:
    commands = table().COMMANDS
    width = max(len(name) for name in commands)
    lines = [
        (
            "lem NAME ARGS... runs one of Lem's scripts; "
            "`lem NAME --help` gives its own help."
        ),
        "",
    ]
    lines += [f"  {name:<{width}}  {about}" for name, (_, about) in commands.items()]
    lines += [
        (
            f"  {'version':<{width}}  the plugin's version and the commit "
            "of its folder, as JSON"
        ),
        f"  {'help':<{width}}  this list",
        "",
        (
            "lem-ask (the question page) and lem-jev (the Jev model) are "
            "commands of their own."
        ),
    ]
    return "\n".join(lines) + "\n"


def version() -> dict:
    found: dict[str, object] = {"root": ROOT, "version": None, "commit": None}
    try:
        with open(
            os.path.join(ROOT, ".claude-plugin", "plugin.json"), encoding="utf-8"
        ) as manifest:
            found["version"] = json.load(manifest).get("version")
    except (OSError, ValueError):
        pass
    if os.path.exists(os.path.join(ROOT, ".git")):
        ran = subprocess.run(
            ["git", "-C", ROOT, "rev-parse", "--short", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        if ran.returncode == 0:
            found["commit"] = ran.stdout.strip()
    return found


def run(name: str, args: list, command: str, *, look: bool = False) -> None:
    """Become the entry with NAME and ARGS, under this Python when it is 3.11 or newer,
    else under one it finds; with LOOK, after the look at the board server."""
    python = sys.executable or "python3"
    if sys.version_info < (3, 11):
        package()
        from lem import python as lem_python

        python = lem_python.find(python3=False)
        if python is None:
            sys.exit(lem_python.missing(command))
    if look:
        look_for_server(python)
    os.execv(python, [python, "-B", MAIN, name, *args])


def release(called: str) -> "str | None":
    """The file of the newest installed release that CALLED (`lem`, `lem-ask` or
    `lem-jev`) stands for, when this file is in a marketplace clone; None elsewhere. The
    clone holds the head of `main`, which no release holds, so nothing of it runs but
    this. A clone with no release listed exits 1."""
    market = os.path.dirname(ROOT)
    plugins = os.path.dirname(market)
    if (
        os.path.basename(market) != "marketplaces"
        or os.path.basename(plugins) != "plugins"
    ):
        return None
    key = "lem@" + os.path.basename(ROOT)
    name = called if called in LINKS else "lem"
    newest = None
    try:
        with open(
            os.path.join(plugins, "installed_plugins.json"), encoding="utf-8"
        ) as listed:
            installs = json.load(listed).get("plugins", {}).get(key, [])
    except (OSError, ValueError, AttributeError):
        installs = []
    # Claude Code's own file: an entry of another shape, or a version that is not
    # numbers, is no release
    for entry in installs if isinstance(installs, list) else []:
        try:
            number = tuple(int(part) for part in entry["version"].split("."))
            target = os.path.join(entry["installPath"], "bin", name)
        except (ValueError, AttributeError, KeyError, TypeError):
            continue
        if os.path.isfile(target) and (newest is None or number > newest[0]):
            newest = (number, target)
    if newest is None:
        sys.exit(
            f"lem: {ROOT} is the marketplace clone of {key}, which holds the head of "
            "main and no release, and "
            f"{os.path.join(plugins, 'installed_plugins.json')} lists no release of it "
            f"to run: the owner installs one with `claude plugin install {key}`"
        )
    return newest[1]


def main() -> None:
    called = os.path.basename(sys.argv[0])
    target = release(called)
    if target is not None:
        if sys.executable:
            os.execv(sys.executable, [sys.executable, target, *sys.argv[1:]])
        os.execv(target, [target, *sys.argv[1:]])
    if called in LINKS:
        run(called, sys.argv[1:], called)
    args = sys.argv[1:]
    if not args or args[0] in ("help", "--help", "-h"):
        sys.stdout.write(names())
        return
    name, rest = args[0], args[1:]
    if name == "version":
        print(json.dumps(version(), indent=2))
        return
    commands = table().COMMANDS
    if name not in commands:
        sys.stderr.write(
            f"lem: {name!r} is no command of Lem's; the names are:\n\n" + names()
        )
        sys.exit(1)
    script = os.path.join(ROOT, "src", "lem", commands[name][0] + ".py")
    if not os.path.isfile(script):
        sys.exit(
            f"lem: {script} is not there: the plugin's folder {ROOT} is not whole; "
            "install the plugin again"
        )
    run(name, rest, "lem", look=name not in NO_LOOK)


if __name__ == "__main__":
    main()
