{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$CLAUDE_PLUGIN_ROOT/hooks/run\" corrections 2>/dev/null || :",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$CLAUDE_PLUGIN_ROOT/hooks/run\" serve 2>/dev/null || :",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$CLAUDE_PLUGIN_ROOT/hooks/run\" session-start 2>/dev/null || :",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$CLAUDE_PLUGIN_ROOT/hooks/run\" precompact 2>/dev/null || :",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$CLAUDE_PLUGIN_ROOT/hooks/run\" stop 2>/dev/null || :",
            "async": true
          }
        ]
      }
    ]
  }
}
