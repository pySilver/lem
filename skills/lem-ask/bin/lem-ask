#!/usr/bin/env python3
"""lem-ask — ask the user a rich question in an agterm HTML overlay and print the answer as JSON.

  lem-ask SPEC.json | lem-ask - < spec.json      ask from a JSON spec (see SKILL.md for the schema)
  lem-ask q "Prompt" "Label|subtitle" "*Recommended|subtitle|why" ... [--multi] [--context MD]
  lem-ask wait PAGE_ID                          resume waiting after a timeout (exit 4)
  lem-ask close [PAGE_ID]                       close the question page this session shows (that one, when named),
                                                whose answer came from elsewhere; its waiter ends as dismissed
  lem-ask demo [NAME ...]                       open bundled demos (no name: list them)
  lem-ask templates                             list templates with their one-line purpose
  lem-ask render SPEC -o FILE                   build the page only, open nothing
  lem-ask hook-stop                             the plugin's Stop hook (not for agents to run)

Common flags: --follow (pull the user to this session), --size N (floating panel, % of the
session), --timeout SEC (default 570, under the Bash tool's 600 s cap), --browser (force the
local-browser fallback), --no-status (leave the sidebar glyph alone).

Exit codes: 0 answered or "chat" (user wants to discuss in the terminal), 2 dismissed (closed
unanswered), 3 no way to show it (outside agterm without --browser, or an unattended run),
4 still pending after --timeout (run `lem-ask wait ID`), 5 the session already shows an overlay,
1 error.

Environment: AGTERMCTL (path to agtermctl). The personal defaults are the table [ask] of Lem's own
settings file, $XDG_CONFIG_HOME/lem/settings.toml or ~/.config/lem/settings.toml (`browser = true`
there opens the page in the browser outside agterm); the mermaid bundle is kept in
$XDG_CACHE_HOME/lem or ~/.cache/lem.
"""

import argparse
import base64
import datetime as dt
import difflib
import hashlib
import http.client
import http.server
import json
import mimetypes
import os
import re
import secrets
import shutil
import socketserver
import subprocess
import sys
import threading
import time
import tomllib
import typing
import urllib.request
import webbrowser
from collections.abc import Callable, Mapping
from pathlib import Path
from typing import Any, NoReturn

# the skill's directory: this file is bin/lem-ask
HERE = Path(__file__).resolve().parent.parent
RUNTIME = HERE / "runtime"
TEMPLATES = HERE / "templates"
DEMOS = HERE / "demos"
DEFAULTS = HERE / "defaults.json"
# The keys of the table [ask] of Lem's home settings file; `lem project` takes the same five (project.py TABLES).
ASK_KEYS = ("style", "size", "review", "browser", "status")
STATUS_KEYS = ("asking", "answered")
OUTDIR = os.path.join(os.environ.get("TMPDIR", "/tmp"), "lem-ask")  # noqa: PTH118, S108 - the folder prints as TMPDIR is written, a // kept; /tmp when TMPDIR names none
# Seconds an old page stays in OUTDIR, for debugging.
PAGE_KEEP = 86400
MERMAID_URL = "https://cdn.jsdelivr.net/npm/mermaid@11.12.0/dist/mermaid.min.js"
MERMAID_NAME = "mermaid-11.12.0.min.js"
# jsDelivr's published sha256 for that file (data.jsdelivr.com/v1/package/npm/mermaid@11.12.0/flat).
# The page runs with agterm's bridge, which can type into terminals, so unverified code never goes in.
MERMAID_SHA256 = "07e37dfa97b337ccc85365d57eddf99b9706f09db3b59b260d0333b23b343c4b"
MAX_IMAGE = 8 * 1024 * 1024
# When the plugin's Stop hook finds a question page still open, it re-posts the asking status at these
# offsets (seconds): status hooks run in parallel with it, so a slower one may post after it does, and
# one slower than the last offset wins.
STOP_RECHECKS = (0.5, 1.5, 3, 6)
SOURCED = (
    "code",
    "diff",
    "md",
    "mermaid",
)  # blocks whose text may come from {"file": …}
CODE_MAX_LINES = 300  # a whole file past this needs `lines`: nobody reads 3,000 lines to find the 20 in question


def emit(obj: object, code: int) -> NoReturn:
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(code)


def die(msg: str, code: int = 1) -> NoReturn:
    emit({"status": "error", "error": msg}, code)


# ---------- spec loading ----------


def load_spec(arg: str | None) -> dict[str, Any]:
    if arg in (None, "-"):
        if sys.stdin.isatty():
            die("no spec: pass a JSON file or pipe one on stdin")
        try:
            raw = sys.stdin.buffer.read().decode("utf-8")
        except UnicodeDecodeError as e:
            die(f"the spec on stdin is not UTF-8 text: {e}")
    else:
        try:
            with open(os.path.expanduser(arg), encoding="utf-8") as f:  # noqa: PTH111, PTH123 - the message shows the path as its caller wrote it, and Path.expanduser raises on a ~user it does not know
                raw = f.read()
        except UnicodeDecodeError as e:
            die(f"the spec {arg} is not UTF-8 text: {e}")
        except OSError as e:
            die(f"cannot read the spec: {e}")
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"spec is not valid JSON: {e}")


# The keys the page reads, so a misnamed one fails here instead of vanishing from the page. A key that
# starts with "_" is the author's own (`_about` in the templates, or data for a `script`) and passes.
TOP_KEYS = {
    "title",
    "subtitle",
    "source",
    "context",
    "width",
    "submitLabel",
    "chat",
    "script",
    "style",
    "review",
    "size",
    "questions",
}
QUESTION_KEYS = {
    "id",
    "header",
    "prompt",
    "hint",
    "context",
    "body",
    "recommendation",
    "mode",
    "min",
    "max",
    "layout",
    "columns",
    "expanded",
    "optional",
    "text",
    "toggle",
    "options",
    "controls",
    "preview",
    "baseline",
}
OPTION_KEYS = {
    "id",
    "label",
    "subtitle",
    "recommended",
    "badge",
    "tags",
    "pros",
    "cons",
    "detail",
    "preview",
    "default",
    "selected",
    "values",
}
CONTROL_KEYS = {
    "id",
    "label",
    "type",
    "min",
    "max",
    "step",
    "value",
    "unit",
    "options",
    "on",
    "off",
}
# A label that only counts ("Criterion 3", "Option B", "Step 2") points at text the user has to go and find.
# A bare number or letter can be the answer itself (3 replicas, size M), so the counting word is required.
# The word "story" stays among them: a page an agent writes outside Lem may count its user stories so.
POSITION_LABEL = re.compile(
    r"^\s*(?:criterion|story|option|item|task|step|choice|variant|approach|fork|finding|issue|point|"
    r"case|scenario|alternative|proposal|version|question)\s*[#№]?\s*(?:\d+|[a-z])\s*[.):]?\s*$",
    re.IGNORECASE,
)


KEY_PLACES = {
    "at the top level": TOP_KEYS,
    "on a question": QUESTION_KEYS,
    "on an option": OPTION_KEYS,
    "on a control": CONTROL_KEYS,
}


# The type of each field the page shows or reads as a switch, as (what it is, test). A value of another
# type does not fail on the page: a label of null showed as the option's id ("o1"), a prompt of 5 as
# "5", a mode of "multiple" as options nobody can pick. Blocks (context, body, detail, preview) take
# any block and are not listed.
def _text(v: object) -> bool:
    return isinstance(v, str)


def _flag(v: object) -> bool:
    return isinstance(v, bool)


def _count(v: object) -> bool:
    return isinstance(v, int) and not isinstance(v, bool)


def _number(v: object) -> bool:
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _texts(v: object) -> bool:
    return isinstance(v, list) and all(isinstance(x, str) for x in v)


def _one_of(*words: str) -> tuple[str, Callable[[object], bool]]:
    return (" or ".join(json.dumps(w) for w in words), lambda v: v in words)


TEXT, FLAG, COUNT, NUMBER = (
    ("a string", _text),
    ("true or false", _flag),
    ("a whole number", _count),
    ("a number", _number),
)
TEXTS = ("a list of strings", _texts)
TOP_TYPES = {
    "title": TEXT,
    "subtitle": TEXT,
    "source": TEXT,
    "submitLabel": TEXT,
    "chat": FLAG,
    "script": TEXT,
    "width": _one_of("narrow"),
    "style": _one_of("refined", "minimal", "bold", "terminal"),
    "review": (
        '"auto", "always", "never", true or false',
        lambda v: isinstance(v, bool) or v in ("auto", "always", "never"),
    ),
}
QUESTION_TYPES = {
    "header": TEXT,
    "prompt": TEXT,
    "hint": TEXT,
    "recommendation": TEXT,
    "mode": _one_of("single", "multi", "text", "tune"),
    "layout": _one_of("list", "grid", "compare", "inline"),
    "min": COUNT,
    "max": COUNT,
    "columns": COUNT,
    "expanded": FLAG,
    "optional": FLAG,
    "toggle": FLAG,
    "baseline": ("true, false or a label", lambda v: isinstance(v, (bool, str))),
    "text": ("false or an object", lambda v: isinstance(v, (bool, dict))),
}
OPTION_TYPES = {
    "label": TEXT,
    "subtitle": TEXT,
    "badge": TEXT,
    "tags": TEXTS,
    "pros": TEXTS,
    "cons": TEXTS,
    "recommended": (
        "true, false or the reason as a string",
        lambda v: isinstance(v, (bool, str)),
    ),
    "default": FLAG,
    "selected": FLAG,
    "values": ("an object", lambda v: isinstance(v, dict)),
}
CONTROL_TYPES = {
    "id": TEXT,
    "label": TEXT,
    "unit": TEXT,
    "min": NUMBER,
    "max": NUMBER,
    "step": NUMBER,
    "options": (
        "a list of strings or numbers",
        lambda v: isinstance(v, list) and all(_text(x) or _number(x) for x in v),
    ),
    "type": _one_of("range", "hue", "color", "select", "toggle"),
}


def check_types(
    node: dict[str, Any],
    types: Mapping[str, tuple[str, Callable[[object], bool]]],
    where: str,
) -> None:
    for key, (what, test) in types.items():
        if key in node and not test(node[key]):
            die(f"{where}: `{key}` must be {what}, got {json.dumps(node[key])}")


def check_keys(node: dict[str, Any], allowed: set[str], where: str) -> None:
    unknown = sorted(k for k in node if k not in allowed and not k.startswith("_"))
    if not unknown:
        return

    def hint(k: str) -> str:
        if m := difflib.get_close_matches(k, allowed, n=1):
            return f"{k!r} (did you mean {m[0]!r}?)"
        if m := difflib.get_close_matches(k, set().union(*KEY_PLACES.values()), n=1):
            places = " or ".join(p for p, keys in KEY_PLACES.items() if m[0] in keys)
            return f"{k!r} (did you mean {m[0]!r}? it belongs {places})"
        return repr(k)

    die(
        f"{where}: unknown key {', '.join(hint(k) for k in unknown)}; the page would drop it without a word"
    )


def says_nothing(o: str | dict[str, Any]) -> bool:
    """An option that is only a counting label: nothing on the page says what it is."""
    label = o if isinstance(o, str) else str(o.get("label") or o.get("id") or "")
    if not POSITION_LABEL.match(label):
        return False
    if isinstance(o, str):
        return True
    return not (
        o.get("subtitle")
        or o.get("detail")
        or o.get("preview") is not None
        or o.get("pros")
        or o.get("cons")
        or o.get("tags")
        or isinstance(o.get("recommended"), str)
        or o.get("values")
    )


SIZE_WHAT = '"auto", "full" or a whole percent of the session from 1 to 100'
MAX_OPTIONS = 9  # the keys 1-9 pick an option


def size_valid(size: object) -> bool:
    """A panel size is "auto", "full" or a whole percent of 1 to 100."""
    return size in ("auto", "full") or (
        isinstance(size, int) and not isinstance(size, bool) and 1 <= size <= 100  # noqa: PLR2004 - a percent
    )


def size_problem(size: object) -> str | None:
    """What is wrong with a panel size of a spec, or None."""
    return None if size_valid(size) else f"`size` is {SIZE_WHAT}, not {size!r}"


def check_spec(spec: object) -> None:
    """The spec's shape, and the type of every field this script reads itself; the page reads the rest."""
    if not isinstance(spec, dict):
        die("spec must be a JSON object")
    qs = spec.get("questions", [spec])
    if not isinstance(qs, list) or not qs:
        die("`questions` must be a non-empty list")
    check_keys(
        spec, TOP_KEYS if "questions" in spec else TOP_KEYS | QUESTION_KEYS, "spec"
    )
    check_types(spec, TOP_TYPES, "spec")
    if "size" in spec and (problem := size_problem(spec["size"])):
        die(f"spec: {problem}")
    ids: set[str] = set()
    for i, q in enumerate(qs):
        if not isinstance(q, dict):
            die(f"question {i + 1} must be a JSON object, got {type(q).__name__}")
        if q.get("id") is not None and not isinstance(q["id"], str):
            die(f"question {i + 1}: `id` must be a string, got {json.dumps(q['id'])}")
        qid = q.get("id") or (f"q{i + 1}" if spec.get("questions") else "answer")
        if "questions" in spec:
            check_keys(q, QUESTION_KEYS, f"question {qid!r}")
        check_types(q, QUESTION_TYPES, f"question {qid!r}")
        controls = q.get("controls") or []
        if not isinstance(controls, list):
            die(
                f"question {qid!r}: `controls` must be a list of objects, got {json.dumps(controls)}"
            )
        for k, c in enumerate(controls):
            if not isinstance(c, dict):
                die(
                    f"question {qid!r}: control {k + 1} must be an object with an id, a label and a value, got {json.dumps(c)}"
                )
            check_keys(c, CONTROL_KEYS, f"question {qid!r}, control {c.get('id')!r}")
            check_types(c, CONTROL_TYPES, f"question {qid!r}, control {k + 1}")
        if qid in ids:
            die(f"duplicate question id {qid!r}")
        ids.add(qid)
        opts = q.get("options") or []
        if not isinstance(opts, list):
            die(f"question {qid!r}: `options` must be a list")
        if len(opts) > MAX_OPTIONS:
            die(
                f"question {qid!r} has {len(opts)} options; keys 1-9 cover at most 9 (aim for 6)"
            )
        for j, o in enumerate(opts):
            if not isinstance(o, (str, dict)):
                die(f"question {qid!r}: option {j + 1} must be a string or an object")
            if isinstance(o, dict):
                if o.get("id") is not None and not isinstance(o["id"], str):
                    die(
                        f"question {qid!r}: option {j + 1}: `id` must be a string, got {json.dumps(o['id'])}"
                    )
                check_keys(
                    o, OPTION_KEYS, f"question {qid!r}, option {o.get('id') or j + 1!r}"
                )
                check_types(o, OPTION_TYPES, f"question {qid!r}, option {j + 1}")
            if says_nothing(o):
                shown = o if isinstance(o, str) else o.get("label") or o.get("id")
                die(
                    f"question {qid!r}: option {shown!r} only counts; put what the user is choosing on the option "
                    f"itself: a label that says it, the gist in `subtitle`, the full text in `detail` (or "
                    f'{{"md": {{"file": …, "lines": …}}}}), with `expanded: true` when the text is what they judge'
                )
        oids = [
            o if isinstance(o, str) else o.get("id") or f"o{j + 1}"
            for j, o in enumerate(opts)
        ]  # as the runtime assigns them
        if len(oids) != len(set(oids)):
            die(
                f"question {qid!r} has duplicate option ids (an option without an id is o1, o2, … by position)"
            )
        if not q.get("prompt") and not spec.get("title"):
            die(f"question {qid!r} has no prompt")


def line_range(spec: object, total: int, path: str) -> tuple[int, int]:
    """`"40-60"`, `"40"` or `[40, 60]` → 1-based inclusive (first, last), checked against the file."""
    if isinstance(spec, list) and len(spec) == 2:  # noqa: PLR2004 - [first, last]
        first, last = spec
    else:
        a, _, b = str(spec).partition("-")
        first, last = a, b or a
    try:
        first, last = int(first), int(last)
    except (TypeError, ValueError):
        die(f'{path}: lines must look like "40-60", "40" or [40, 60], got {spec!r}')
    if not 1 <= first <= last <= total:
        die(f"{path}: lines {first}-{last} are outside the file's 1-{total}")
    return first, last


def load_files(node: object, base: str) -> None:
    """Replace `{"file": …}` in code, diff, md and mermaid blocks with the file's text.

    Source code pasted into JSON by hand is where a spec breaks or a snippet drifts from the
    real file; reading it here shows the user exactly what is on disk."""
    if isinstance(node, list):
        for v in node:
            load_files(v, base)
        return
    if not isinstance(node, dict):
        return
    for k in SOURCED:
        src = node.get(k)
        if not (isinstance(src, dict) and "file" in src):
            continue
        shown = src["file"]
        if not isinstance(shown, str) or not shown.strip():
            die(
                f"{k} block: `file` is the path of a file in quotes, got {json.dumps(shown)}"
            )
        p = os.path.expanduser(shown)  # noqa: PTH111 - Path.expanduser raises on a ~user it does not know
        if not Path(p).is_absolute():
            p = os.path.join(base, p)  # noqa: PTH118 - the message shows the path as its caller wrote it, a ./ kept
        try:
            with open(p, encoding="utf-8") as f:  # noqa: PTH123 - the message shows the path as its caller wrote it, a ./ kept
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            die(f"{k} block: cannot read {shown}: {e}")
        lines = text.splitlines()
        if k == "code" and "lines" not in src and len(lines) > CODE_MAX_LINES:
            die(
                f'code block: {shown} has {len(lines)} lines; pass "lines" ("40-62") for the part the question is about'
            )
        if k == "code" or "lines" in src:
            first, last = (
                line_range(src["lines"], len(lines), shown)
                if "lines" in src
                else (1, len(lines))
            )
            text = "\n".join(lines[first - 1 : last])
            if k == "code":
                node.setdefault("start", first)
                node.setdefault(
                    "title", f"{shown}:{first}-{last}" if "lines" in src else shown
                )
                ext = os.path.splitext(p)[1].lstrip(".")  # noqa: PTH122 - a name of leading dots, as ..py, has no extension here, where Path.suffix gives one
                if ext:
                    node.setdefault("lang", ext)
        node[k] = text
    for v in node.values():
        load_files(v, base)


def embed_images(node: object, base: str) -> None:
    """Replace local `image` paths with data URIs: a page without --cwd has no file access."""
    if isinstance(node, dict):
        for k, v in list(node.items()):
            if (
                k == "image"
                and isinstance(v, str)
                and not v.startswith(("http://", "https://", "data:"))
            ):
                # Path(base, p) is p itself when p is absolute
                p = Path(base, os.path.expanduser(v))  # noqa: PTH111 - Path.expanduser raises on a ~user it does not know
                if not p.is_file():
                    node[k] = ""
                    node.setdefault("alt", f"missing image: {v}")
                    continue
                if p.stat().st_size > MAX_IMAGE:
                    die(f"image too large to embed (>8MB): {v}")
                mime = mimetypes.guess_type(p)[0] or "image/png"
                with p.open("rb") as f:
                    node[k] = (
                        f"data:{mime};base64," + base64.b64encode(f.read()).decode()
                    )
            else:
                embed_images(v, base)
    elif isinstance(node, list):
        for v in node:
            embed_images(v, base)


# A ```mermaid fence in markdown text, which ask.js draws as a chart, as the board's MERMAID_FENCE does.
MERMAID_FENCE = re.compile(r"^[ ]{0,3}(?:`{3,}|~{3,})[ \t]*mermaid\b", re.MULTILINE)


def uses_mermaid(node: object) -> bool:
    """A {"mermaid": …} block, or a mermaid fence in text the page reads as markdown.

    The text of a code or diff block is shown as written, so a fence there needs no bundle."""
    if isinstance(node, dict):
        return "mermaid" in node or any(
            uses_mermaid(v) for k, v in node.items() if k not in ("code", "diff")
        )
    if isinstance(node, list):
        return any(uses_mermaid(v) for v in node)
    if isinstance(node, str):
        return bool(MERMAID_FENCE.search(node))
    return False


def mermaid_js() -> str:
    """The pinned mermaid bundle, verified on every read; "" (diagrams show as source) when unavailable."""

    def verified(data: bytes) -> bool:
        return hashlib.sha256(data).hexdigest() == MERMAID_SHA256

    cache = lem_folder("XDG_CACHE_HOME", ".cache")
    file = os.path.join(cache, MERMAID_NAME)  # noqa: PTH118 - the messages show the file as XDG_CACHE_HOME is written
    try:
        with open(file, "rb") as f:  # noqa: PTH123 - the message shows the file as XDG_CACHE_HOME is written
            data = f.read()
        if verified(data):
            return data.decode("utf-8")
        print(
            f"lem-ask: {file} fails its sha256 check; fetching it again",
            file=sys.stderr,
        )
    except FileNotFoundError:
        pass
    except OSError as e:
        print(f"lem-ask: cannot read {file} ({e}); fetching it again", file=sys.stderr)
    try:
        with urllib.request.urlopen(MERMAID_URL, timeout=20) as r:
            data = r.read()
    except (OSError, http.client.HTTPException) as e:
        print(
            f"lem-ask: mermaid unavailable ({e}); diagrams show as source",
            file=sys.stderr,
        )
        return ""
    if not verified(data):
        print(
            f"lem-ask: {MERMAID_URL} does not match its pinned sha256; not using it, diagrams show as source",
            file=sys.stderr,
        )
        return ""
    try:
        os.makedirs(cache, exist_ok=True)  # noqa: PTH103 - the message shows the folder as XDG_CACHE_HOME is written
        tmp = file + f".{os.getpid()}.tmp"
        with open(tmp, "wb") as f:  # noqa: PTH123 - the message shows the file as XDG_CACHE_HOME is written
            f.write(data)
        os.replace(tmp, file)  # noqa: PTH105 - the message shows the files as XDG_CACHE_HOME is written
    except (
        OSError
    ) as e:  # the page still gets the verified bundle; only the cache is lost
        print(f"lem-ask: cannot cache mermaid ({e})", file=sys.stderr)
    return data.decode("utf-8")


def build_html(spec: dict[str, Any], base: str) -> str:
    load_files(spec, base)
    embed_images(spec, base)

    def read(name: str) -> str:
        with (RUNTIME / name).open(encoding="utf-8") as f:
            return f.read()

    css, js = read("ask.css"), read("ask.js")
    mm = mermaid_js() if uses_mermaid(spec) else ""
    data = (
        json.dumps(spec, ensure_ascii=False)
        .replace("</", "<\\/")
        .replace("<!--", "<\\u0021--")
    )
    title = (
        spec.get("title")
        or (spec.get("questions") or [spec])[0].get("prompt")
        or "Question"
    )

    def esc(s: object) -> str:
        return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    return (
        '<!doctype html><html><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width,initial-scale=1">'
        f"<title>{esc(title)[:120]}</title><style>{css}</style></head>"
        f'<body><div id="app"></div><script type="application/json" id="hd-spec">{data}</script>'
        + (f"<script>{mm}</script>" if mm else "")
        + f"<script>{js}</script></body></html>"
    )


def write_page(html: str) -> str:
    try:
        os.makedirs(OUTDIR, exist_ok=True)  # noqa: PTH103 - the message shows the folder as TMPDIR is written
    except OSError as e:
        die(
            f"cannot make the folder for the page, {OUTDIR}: {e}; point TMPDIR at a folder this user may write"
        )
    now = time.time()
    for old in Path(OUTDIR).glob("*.html"):  # keep a day for debugging
        if old.name.startswith("."):
            continue  # glob.glob's rule, which this followed: a hidden file is none of these
        try:
            if now - old.stat().st_mtime > PAGE_KEEP:
                old.unlink()
        except OSError:
            pass
    path = os.path.join(  # noqa: PTH118 - the page's path prints as TMPDIR is written
        OUTDIR, time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(3) + ".html"
    )
    with open(path, "w", encoding="utf-8") as f:  # noqa: PTH123 - an error shows the path as TMPDIR is written
        f.write(html)
    return path


class DefaultsError(Exception):
    """A defaults file, or a folder of Lem's, this script cannot use; the message names the file and the fix."""


def lem_folder(variable: str, fallback: str) -> str:
    """Lem's folder under one base directory of XDG: `$VARIABLE/lem` when the variable is set and not
    empty, else `~/FALLBACK/lem`. It is the rule of `lem_state.config()`, which this script cannot
    import: it runs alone, on the standard library only. A relative path is refused, since it would be
    read from the folder each command starts in."""
    named = os.environ.get(variable, "")
    if not named:
        return os.path.join(os.path.expanduser("~"), fallback, "lem")  # noqa: PTH111, PTH118 - with no HOME and no passwd entry this gives ~, where Path.home() raises
    if not Path(named).is_absolute():
        raise DefaultsError(
            f"{variable} is {named!r}, a relative path: set it to an absolute path, or unset it for ~/{fallback}"
        )
    return os.path.join(named, "lem")  # noqa: PTH118 - the folder prints as the variable is written, a // kept


def settings_file() -> str:
    """Lem's settings file of the home folder, whose table [ask] holds the user's own defaults."""
    return os.path.join(lem_folder("XDG_CONFIG_HOME", ".config"), "settings.toml")  # noqa: PTH118 - the file prints as XDG_CONFIG_HOME is written, a // kept


def shown(path: str) -> str:
    """A file of the home directory as a person writes it, ~/.config/lem/settings.toml; another as it is."""
    home = os.path.expanduser("~")  # noqa: PTH111 - with no HOME and no passwd entry this gives ~, where Path.home() raises
    return (
        "~/" + os.path.relpath(path, home)
        if path.startswith(home.rstrip(os.sep) + os.sep)
        else path
    )


def toml_text(value: object) -> str:
    """A value as TOML writes it, for a message: json.dumps raises on a date, which TOML has."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        escaped = value.replace("\\", "\\\\").replace('"', '\\"')
        return (
            '"'
            + "".join(
                f"\\u{ord(c):04x}" if c < " " or c == "\x7f" else c for c in escaped
            )
            + '"'
        )
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, (dt.datetime, dt.date, dt.time)):
        return value.isoformat()
    if isinstance(value, list):
        return "[" + ", ".join(toml_text(item) for item in value) + "]"
    if isinstance(value, dict):
        bare = re.compile(r"[A-Za-z0-9_-]+")
        return (
            "{"
            + ", ".join(
                f"{k if bare.fullmatch(k) else toml_text(k)} = {toml_text(v)}"
                for k, v in value.items()
            )
            + "}"
        )
    return "null"  # JSON's null, which only the skill's own defaults.json can hold: TOML has none


def defaults_problem(values: object) -> str | None:
    """What is wrong with the defaults, or None. Each key's type is checked by the spec's own rule
    (TOP_TYPES, size_valid) before its value is used, and a value is named as TOML writes it."""
    if not isinstance(values, dict):
        return f"the defaults are a table of settings, not {toml_text(values)}"
    for key in values:
        if key not in ASK_KEYS:
            near = difflib.get_close_matches(key, ASK_KEYS, n=1)
            return f"`{key}` is no key of the defaults{f' (did you mean `{near[0]}`?)' if near else ''}: they are {', '.join(ASK_KEYS)}"
    for key in ("style", "review"):
        what, test = TOP_TYPES[key]
        if key in values and not test(values[key]):
            return f"`{key}` is {what}, not {toml_text(values[key])}"
    if "size" in values and not size_valid(values["size"]):
        return f"`size` is {SIZE_WHAT}, not {toml_text(values['size'])}"
    if "browser" in values and not isinstance(values["browser"], bool):
        return f"`browser` is true or false, not {toml_text(values['browser'])}"
    status = values.get("status", {})
    if not isinstance(status, dict) or any(key not in STATUS_KEYS for key in status):
        return (
            f"`status` is a table of `asking` and `answered`, not {toml_text(status)}"
        )
    for key, glyph in status.items():
        if (
            not isinstance(glyph, list)
            or not glyph
            or not all(isinstance(word, str) and word for word in glyph)
        ):
            return f'`status.{key}` is a list of the words `agtermctl session status` takes, as ["blocked"], not {toml_text(glyph)}'
    return None


def defaults() -> dict[str, Any]:
    """The skill's neutral defaults.json, overlaid by the table [ask] of Lem's home settings file. A
    file that does not read, or a value of the wrong type, is refused: a setting dropped without a word
    would be a page that looks other than its owner chose."""
    try:
        with DEFAULTS.open(encoding="utf-8") as f:
            merged = json.load(f)
    except (OSError, ValueError) as e:
        raise DefaultsError(
            f"{DEFAULTS} cannot be read as JSON ({e}); install the plugin again"
        ) from e
    if problem := defaults_problem(merged):
        raise DefaultsError(f"{DEFAULTS}: {problem}; install the plugin again")
    path = settings_file()
    try:
        with Path(path).open("rb") as f:
            whole = tomllib.load(f)
    except FileNotFoundError:
        return merged
    except OSError as e:
        raise DefaultsError(
            f"{shown(path)} cannot be read ({e.strerror}); correct the file or remove it"
        ) from e
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as e:
        raise DefaultsError(
            f"{shown(path)} does not read as TOML ({e}); correct the file"
        ) from e
    values = whole.get("ask", {})
    if not isinstance(values, dict):
        raise DefaultsError(
            f"{shown(path)}: `ask` is the table [ask], not {toml_text(values)}; correct the file"
        )
    if problem := defaults_problem(values):
        raise DefaultsError(
            f"{shown(path)}, under [ask]: {problem}; correct the file or remove the key"
        )
    merged.update(values)
    return merged


def apply_defaults(spec: dict[str, Any]) -> dict[str, Any]:
    d = defaults()
    spec.setdefault("style", d.get("style", "refined"))
    spec.setdefault("review", d.get("review", "auto"))
    return spec


def auto_size(spec: dict[str, Any]) -> int:
    """Pick the floating-panel percent from how much the page has to show."""
    qs = spec.get("questions") or [spec]
    blob = json.dumps(spec)
    visual = any(
        k in blob
        for k in ('"preview"', '"mermaid"', '"chart"', '"image"', '"stats"', '"table"')
    )
    compare = any(q.get("layout") == "compare" for q in qs)
    nopts = max((len(q.get("options") or []) for q in qs), default=0)
    if visual or compare or len(qs) > 2:  # noqa: PLR2004 - this guess's own bound, read nowhere else
        return 90
    if spec.get("width") == "narrow" and nopts <= 4 and len(blob) < 1500:  # noqa: PLR2004 - this guess's own bounds, read nowhere else
        return 66
    return 78


# ---------- agterm ----------

# Replies in a row that do not read as JSON before a wait gives agterm up.
UNREADABLE_REPLIES = 5


def agtermctl() -> str | None:
    return (
        os.environ.get("AGTERMCTL")
        or shutil.which("agtermctl")
        or next(
            (
                p
                for p in (
                    "/opt/homebrew/bin/agtermctl",
                    "/Applications/agterm.app/Contents/MacOS/agtermctl",
                )
                if Path(p).exists()
            ),
            None,
        )
    )


def ctl(*args: str | None, check: bool = True) -> subprocess.CompletedProcess[str]:
    exe = agtermctl()
    cmd = [exe, *args]
    if os.environ.get("AGTERM_SOCKET"):
        cmd += ["--socket", os.environ["AGTERM_SOCKET"]]
    # every caller runs inside agterm (in_agterm()), where agtermctl and the session's id are found
    r = subprocess.run(
        typing.cast("list[str]", cmd), capture_output=True, text=True, check=False
    )
    if check and r.returncode not in (0, 2):
        raise RuntimeError(
            (r.stderr or r.stdout).strip() or f"agtermctl exited {r.returncode}"
        )
    return r


def in_agterm() -> str | bool | None:
    return (
        os.environ.get("AGTERM_ENABLED") == "1"
        and os.environ.get("AGTERM_SESSION_ID")
        and agtermctl()
    )


def unattended() -> bool:
    """Claude Code sets CLAUDE_CODE_SESSION_ATTENDED=0 in `claude -p` runs, which inherit
    AGTERM_ENABLED=1 when started from an agterm shell. A page there waits for nobody.

    The variable is undocumented (absent from the env-vars page as of Claude Code 2.1.296; read
    from that binary and measured), so only an explicit "0" refuses: if a later version drops it,
    the guard goes quiet rather than blocking attended sessions."""
    return os.environ.get("CLAUDE_CODE_SESSION_ATTENDED") == "0"


def set_status(args: list[str]) -> None:
    sid, pid = os.environ.get("AGTERM_SESSION_ID"), os.environ.get("AGTERM_PANE_ID")
    extra = ["--pane-id", pid] if pid else []
    try:
        ctl("session", "status", *args, "--target", sid, *extra, check=False)
    except OSError as e:  # the glyph is a courtesy; never fail the question over it
        print(f"lem-ask: could not set the status glyph: {e}", file=sys.stderr)


def this_session() -> dict[str, Any] | None:
    """This session's node from `agtermctl tree`, or None when agterm cannot say."""
    args = ["tree", "--json"] + (
        ["--window", os.environ["AGTERM_WINDOW_ID"]]
        if os.environ.get("AGTERM_WINDOW_ID")
        else []
    )
    try:
        workspaces = json.loads(ctl(*args, check=False).stdout)["result"]["tree"][
            "workspaces"
        ]
        return next(
            (
                s
                for w in workspaces
                for s in w.get("sessions") or []
                if s.get("id") == os.environ["AGTERM_SESSION_ID"]
            ),
            None,
        )
    except (OSError, json.JSONDecodeError, KeyError, TypeError, AttributeError):
        return None


def pending_page() -> str | None:
    """The id of a question page open on this session, or None.

    When the overlay slot is taken, the page in it is often this agent's own question, left
    pending by a timeout or a killed call whose output (and page id) is gone after compaction."""
    s = this_session() or {}
    ours = (
        os.path.realpath(OUTDIR) + os.sep
    )  # agterm reports /tmp/… where TMPDIR says /private/tmp/…
    for o in s.get("htmlOverlays") or []:
        if o.get("file") and os.path.realpath(o["file"]).startswith(ours):
            return o.get("id")
    return None


def close_page(page_id: str | None = None) -> None:
    """Close the question page this session shows, the one named when an id is given: a card whose
    answer came from somewhere else (the owner answered it in his inbox), so that it asks no more.

    agterm's `session overlay close` closes whatever page the session shows, so it runs only while
    that page is one of this script's: another tool's overlay (a diff review, a plan annotation) is
    not ours to close, and neither is another question than the one named. With none of ours open
    there is nothing to close, which is no error. The `lem-ask ask` or `wait` that waits on the page
    then ends as a dismissal (exit 2)."""
    if not in_agterm():
        die("not inside agterm, so there is no page to close", 3)
    s = this_session()
    if s is None:
        die(
            "agterm did not say what this session shows; run `agtermctl tree --json` to see why"
        )
    ours = os.path.realpath(OUTDIR) + os.sep
    page = next(
        (
            o.get("id")
            for o in s.get("htmlOverlays") or []
            if o.get("file")
            and os.path.realpath(o["file"]).startswith(ours)
            and page_id in (None, o.get("id"))
        ),
        None,
    )
    if page is None:
        emit(
            {
                "status": "gone",
                "pageID": page_id,
                "hint": "no question page of lem-ask is open on this session"
                + (f" with the id {page_id}" if page_id else "")
                + ": nothing was closed",
            },
            0,
        )
    r = ctl(
        "session",
        "overlay",
        "close",
        "--target",
        os.environ["AGTERM_SESSION_ID"],
        "--json",
        check=False,
    )
    try:
        reply = json.loads(r.stdout)
    except json.JSONDecodeError:
        die(
            (r.stderr or r.stdout).strip()
            or f"agtermctl session overlay close exited {r.returncode}"
        )
    if not reply.get("ok", True) or r.returncode != 0:
        die(
            f"agterm did not close page {page}: {reply.get('error') or (r.stderr or r.stdout).strip()}"
        )
    emit({"status": "closed", "pageID": page}, 0)


def hook_stop() -> None:
    """The plugin's Stop hook: when the turn ends with a question page still open, show the question.

    Status hooks (agterm's own, or the user's) post a "working" or "done" glyph at Stop, and a
    question waiting in the background, or one left pending by a timeout, would read as finished
    work. agterm already refuses a non-blocked status from the OTHER pane while this one is blocked,
    so only this session's own hooks can paint over it. Stop is the moment that is exact: the
    agent's turn is over and the page is still up. Claude Code runs matching hooks in parallel and
    in no fixed order, so this one cannot post last; it runs async (hooks.json) and re-posts the
    asking status at each STOP_RECHECKS offset whenever another hook has posted over it, then stops
    once the page is answered or closed. A Stop hook slower than the last offset still wins.
    It posts with --auto-reset: with no `lem-ask wait` left to reset it, the user's visit clears it.

    Not covered: Stop does not run when the user interrupts the turn (Escape), so then the glyph
    keeps whatever the last hook posted until the next turn ends; the user who pressed Escape is at
    that session, where the page is. And an async Stop hook outlives the next prompt (measured on
    Claude Code 2.1.296), so a turn that starts within the last offset may see asking re-posted over
    its own status until its next tool call; the question is still open then, so that is true.

    Never prints, never fails: a Stop hook's output or exit 2 could hold the session."""
    try:
        if not in_agterm() or unattended():
            return
        if not sys.stdin.isatty():
            sys.stdin.read()  # the hook's JSON input; nothing in it is needed
        page = pending_page()
        if not page:
            return
        asking = defaults().get("status", {}).get("asking", ["blocked"])
        ours = os.path.realpath(OUTDIR) + os.sep
        started = time.time()
        for at in STOP_RECHECKS:
            time.sleep(max(0, started + at - time.time()))
            s = this_session() or {}
            if not any(
                o.get("id") == page
                and o.get("file")
                and os.path.realpath(o["file"]).startswith(ours)
                for o in s.get("htmlOverlays") or []
            ):
                return  # answered or closed in the meantime
            if s.get("status") != asking[0]:
                set_status([*asking, "--auto-reset"])
    except Exception:  # noqa: BLE001 - a hook must never take the session down with it
        return


def open_overlay(path: str, a: argparse.Namespace, spec: dict[str, Any]) -> str | None:
    args = [
        "session",
        "overlay",
        "open",
        "--html",
        path,
        "--js",
        "--target",
        os.environ["AGTERM_SESSION_ID"],
        "--json",
    ]
    if a.follow:
        args.append("--follow")
    size = a.size or spec.get("size") or defaults().get("size", "auto")
    if a.full or size == "full":
        size = None
    elif size == "auto":
        size = auto_size(spec)
    if size:
        args += ["--size-percent", str(int(size))]
    if a.chromeless:
        args.append("--chromeless")
    r = ctl(*args, check=False)
    try:
        reply = json.loads(r.stdout)
    except json.JSONDecodeError:
        die((r.stderr or r.stdout).strip() or "overlay open failed")
    if not reply.get("ok", True) or r.returncode != 0:
        err = reply.get("error") or (r.stderr or r.stdout).strip()
        if err == "overlay already open":
            page = pending_page()
            if page:
                emit(
                    {
                        "status": "busy",
                        "error": err,
                        "pageID": page,
                        "hint": f"a question page is still open on this session, most likely your own unanswered "
                        f"question: run `lem-ask wait {page}` for its answer before asking anything new",
                    },
                    5,
                )
            emit(
                {
                    "status": "busy",
                    "error": err,
                    "hint": "another tool's overlay is open on this session (a diff review, a plan annotation); "
                    "ask in the terminal instead, and do not close an overlay you did not open",
                },
                5,
            )
        die(err)
    res = reply.get("result", reply)
    return res.get("pageID") or res.get("id")


def wait_page(
    page_id: str | None, timeout: float, *, status: bool = True
) -> int | None:
    deadline = time.time() + timeout
    glyphs = defaults().get("status", {})
    asking = glyphs.get("asking", ["blocked"])
    if status:
        set_status(asking)
    still_open = False
    unreadable = 0
    try:
        while True:
            r = ctl(
                "session", "overlay", "result", "--page", page_id, "--json", check=False
            )
            try:
                reply = json.loads(r.stdout)
            except (
                json.JSONDecodeError
            ):  # agterm did not answer at all: a stopped app, a missing socket
                unreadable += 1
                if unreadable >= UNREADABLE_REPLIES:
                    die(
                        f"agterm stopped answering about page {page_id}: {(r.stderr or r.stdout).strip()}"
                    )
                time.sleep(0.4)
                continue
            unreadable = 0
            if not reply.get(
                "ok", True
            ):  # `no such page`, `invalid page id`: waiting longer cannot help
                die(
                    f"page {page_id}: {reply.get('error') or 'agterm refused the result request'}"
                )
            o = reply.get("result", {}).get("pageOutcome", {})
            out = o.get("outcome")
            if out == "submitted":
                try:
                    ans: dict[str, Any] = json.loads(o.get("value") or "{}")
                except json.JSONDecodeError:
                    ans = {
                        "status": "answered",
                        "answers": {
                            "answer": {
                                "selected": [],
                                "labels": [],
                                "text": o.get("value"),
                            }
                        },
                    }
                ans["pageID"] = page_id
                print(json.dumps(ans, ensure_ascii=False, indent=1))
                return 0
            if out == "dismissed":
                print(json.dumps({"status": "dismissed", "pageID": page_id}))
                return 2
            if time.time() > deadline:
                still_open = True  # the question is still up: keep the "asking" glyph
                if status:  # but let a visit clear it: with no waiter left, nothing else would after a ⌘W
                    set_status([*asking, "--auto-reset"])
                print(
                    json.dumps(
                        {
                            "status": "pending",
                            "pageID": page_id,
                            "hint": f"still open; run `lem-ask wait {page_id}` to keep waiting",
                        }
                    )
                )
                return 4
            time.sleep(0.4)
    finally:
        if status and not still_open:
            set_status(glyphs.get("answered", ["active"]))


# ---------- browser fallback ----------

RELOAD_GRACE = (
    3  # seconds a dismissal waits for the page to come back (a reload also unloads it)
)


def ask_in_browser(html: str, timeout: float) -> int:
    state: dict[str, Any] = {"answer": None, "dismissed_at": None}
    done = threading.Event()

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, format: str, *args: object) -> None:  # noqa: A002 - the base class names it so
            pass

        def do_GET(self) -> None:
            state["dismissed_at"] = None  # the page is back: that unload was a reload
            body = html.encode()
            self.send_response(200)
            self.send_header("content-type", "text/html; charset=utf-8")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self) -> None:
            n = int(self.headers.get("content-length", 0))
            try:
                body = json.loads(self.rfile.read(n))
            except json.JSONDecodeError:
                body = {}
            self.send_response(204)
            self.end_headers()
            if body.get("status") == "dismissed":
                state["dismissed_at"] = time.time()
            else:
                state["answer"] = body
                done.set()

    srv = socketserver.TCPServer(("127.0.0.1", 0), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{srv.server_address[1]}/"
    if not webbrowser.open(url):
        srv.shutdown()
        die("not inside agterm and no browser could be opened", 3)
    print(f"lem-ask: opened {url}", file=sys.stderr)
    deadline = time.time() + timeout
    while not done.wait(0.25):
        gone = state["dismissed_at"]
        if gone and time.time() - gone > RELOAD_GRACE:
            srv.shutdown()
            print(json.dumps({"status": "dismissed"}))
            return 2
        if (
            time.time() > deadline
        ):  # the server is gone with this process, so it cannot be resumed
            srv.shutdown()
            print(
                json.dumps(
                    {
                        "status": "timeout",
                        "hint": "browser questions cannot be resumed; ask again with a longer --timeout",
                    }
                )
            )
            return 4
    srv.shutdown()
    print(json.dumps(state["answer"], ensure_ascii=False, indent=1))
    return 0


# ---------- commands ----------


def ask(spec: dict[str, Any], a: argparse.Namespace, base: str) -> int | None:
    check_spec(spec)
    if unattended():
        emit(
            {
                "status": "unattended",
                "error": "this is an unattended run (CLAUDE_CODE_SESSION_ATTENDED=0); nobody is there to answer",
                "hint": "do not ask: proceed on the documented default, or stop and report what you need decided",
            },
            3,
        )
    # Outside agterm the browser is opt-in: the skill tells the agent to just run lem-ask rather than check
    # for agterm first, so an unasked-for browser tab must not be what happens in a plain terminal.
    browser = a.browser or (not in_agterm() and defaults().get("browser") is True)
    if not in_agterm() and not browser:
        emit(
            {
                "status": "no-agterm",
                "error": "not inside agterm, so there is no overlay to show the page in",
                "hint": f"ask in the terminal; --browser, or `browser = true` under [ask] in {shown(settings_file())}, "
                "opens the page in the browser instead",
            },
            3,
        )
    apply_defaults(spec)
    if a.style:
        spec["style"] = a.style
    if a.review:
        spec["review"] = a.review
    html = build_html(spec, base)
    if browser:
        if a.no_wait:
            die(
                "--no-wait needs agterm: the browser fallback answers only while this process runs"
            )
        return ask_in_browser(html, a.timeout)
    path = write_page(html)
    page = open_overlay(path, a, spec)
    if a.no_wait:
        print(json.dumps({"status": "open", "pageID": page, "file": path}))
        return 0
    return wait_page(page, a.timeout, status=not a.no_status)


def quick_spec(a: argparse.Namespace) -> dict[str, Any]:
    opts = []
    for i, raw in enumerate(a.options):
        rec = raw.startswith("*")
        label, _, rest = raw.lstrip("*").partition("|")
        sub, _, why = rest.partition("|")
        o: dict[str, str | bool] = {"id": f"o{i + 1}", "label": label.strip()}
        if sub.strip():
            o["subtitle"] = sub.strip()
        if rec:
            o["recommended"] = why.strip() or True
        opts.append(o)
    spec: dict[str, Any] = {"prompt": a.prompt, "options": opts}
    if a.multi:
        spec["mode"] = "multi"
    if a.context:
        spec["context"] = a.context
    if a.title:
        spec["title"] = a.title
    if opts:
        spec["width"] = "narrow"
    return spec


def list_dir(d: Path) -> list[tuple[str, str]]:
    rows = []
    for p in sorted(d.glob("*.json")):
        if p.name.startswith("."):
            continue  # glob.glob's rule, which this followed: a hidden file is no template
        try:
            with p.open(encoding="utf-8") as f:
                s = json.load(f)
            rows.append((p.name[:-5], s.get("_about", "")))
        except (OSError, json.JSONDecodeError) as e:
            rows.append((p.name[:-5], f"(unreadable: {e})"))
    return rows


def main() -> None:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--follow",
        action="store_true",
        help="select this session so the user sees it now",
    )
    common.add_argument(
        "--size",
        type=int,
        help="floating panel, percent of the session (1-100); default auto",
    )
    common.add_argument(
        "--full",
        action="store_true",
        help="cover the whole session instead of a floating panel",
    )
    common.add_argument(
        "--style",
        choices=["refined", "minimal", "bold", "terminal"],
        help="visual style (default: style under [ask] in ~/.config/lem/settings.toml, else refined)",
    )
    common.add_argument(
        "--review",
        choices=["auto", "always", "never"],
        help="show the answer review before sending",
    )
    common.add_argument(
        "--chromeless", action="store_true", help="hide the overlay's title strip"
    )
    common.add_argument(
        "--timeout", type=float, default=570, help="seconds to wait (default 570)"
    )
    common.add_argument(
        "--no-wait",
        action="store_true",
        help="open and print the page id; read it later with `lem-ask wait`",
    )
    common.add_argument(
        "--no-status", action="store_true", help="leave the sidebar status glyph alone"
    )
    common.add_argument(
        "--browser",
        action="store_true",
        help="open the page in the local browser: outside agterm, or instead of the overlay",
    )

    argv = sys.argv[1:]
    sub = (
        argv[0]
        if argv
        and argv[0]
        in ("q", "wait", "close", "demo", "templates", "render", "ask", "hook-stop")
        else None
    )
    if sub is None:
        argv = ["ask", *argv]
        sub = "ask"

    p = argparse.ArgumentParser(
        prog="lem-ask",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sp = p.add_subparsers(dest="cmd")
    s_ask = sp.add_parser("ask", parents=[common])
    s_ask.add_argument("spec", nargs="?")
    s_q = sp.add_parser("q", parents=[common])
    s_q.add_argument("prompt")
    s_q.add_argument("options", nargs="*")
    s_q.add_argument("--multi", action="store_true")
    s_q.add_argument("--context")
    s_q.add_argument("--title")
    s_w = sp.add_parser("wait", parents=[common])
    s_w.add_argument("page_id")
    s_c = sp.add_parser("close")
    s_c.add_argument("page_id", nargs="?")
    s_d = sp.add_parser("demo", parents=[common])
    s_d.add_argument("names", nargs="*")
    sp.add_parser("templates")
    s_r = sp.add_parser("render")
    s_r.add_argument("spec")
    s_r.add_argument("-o", "--out", required=True)
    sp.add_parser("hook-stop")
    a = p.parse_args(argv)

    if a.cmd == "hook-stop":
        hook_stop()
        sys.exit(0)

    if a.cmd == "ask":
        base = (
            str(Path(os.path.abspath(a.spec)).parent)  # noqa: PTH100 - as written, where resolve() would follow a link
            if a.spec not in (None, "-")
            else str(Path.cwd())
        )
        sys.exit(ask(load_spec(a.spec), a, base))
    if a.cmd == "q":
        sys.exit(ask(quick_spec(a), a, str(Path.cwd())))
    if a.cmd == "wait":
        if not in_agterm():
            die("not inside agterm", 3)
        sys.exit(wait_page(a.page_id, a.timeout, status=not a.no_status))
    if a.cmd == "close":
        close_page(a.page_id)
    if a.cmd == "templates":
        for name, about in list_dir(TEMPLATES):
            print(f"{name:18} {about}")
        print(f"\n{TEMPLATES}")
        return
    if a.cmd == "demo":
        if not a.names:
            for name, about in list_dir(DEMOS) + list_dir(TEMPLATES):
                print(f"{name:18} {about}")
            return
        code = 0
        for name in a.names:
            path = next(
                (
                    os.path.join(d, name + ".json")  # noqa: PTH118 - the messages show the path as the demo's name writes it
                    for d in (DEMOS, TEMPLATES)
                    if (d / (name + ".json")).is_file()
                ),
                None,
            )
            if not path:
                die(f"no demo or template named {name!r}")
            code = ask(load_spec(path), a, os.path.dirname(path))  # noqa: PTH120 - the messages show the folder as the demo's name writes it
            if code not in (0, 2):
                break
        sys.exit(code)
    if a.cmd == "render":
        spec = load_spec(a.spec)
        check_spec(spec)
        apply_defaults(spec)
        base = (
            str(Path(os.path.abspath(a.spec)).parent)  # noqa: PTH100 - as written, where resolve() would follow a link
            if a.spec != "-"
            else str(Path.cwd())
        )
        html = build_html(spec, base)
        try:
            with open(a.out, "w", encoding="utf-8") as f:  # noqa: PTH123 - the message shows the path as its caller wrote it
                f.write(html)
        except OSError as e:
            die(f"cannot write the page to {a.out}: {e}")
        print(a.out)


if __name__ == "__main__":
    try:
        main()
    except DefaultsError as error:
        die(str(error))
